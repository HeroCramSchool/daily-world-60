# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Pexels API (B-roll, free)
# Get at: https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube Data API v3
# Get at: https://console.cloud.google.com/
# OAuth credentials.json path
YOUTUBE_CREDENTIALS_PATH=~/.config/youtube-oauth-credentials.json
YOUTUBE_TOKEN_PATH=~/.config/youtube-oauth-token.json
YOUTUBE_CHANNEL_ID=

# X (Twitter) API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Output settings
OUTPUT_DIR=./output

# Voice settings
EN_VOICE=en-US-AvaNeural
EN_RATE=+5%
EN_PITCH=+0Hz

# Curation settings
CURATION_RECENCY_HOURS=18
CURATION_TARGET_COUNT=3
